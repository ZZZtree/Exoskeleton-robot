/**
 * @file RokaePlgin.cpp
 *
 * @brief 控制系统插件,具体形式不局限于该模板形式，仅插件入口函数必须
 * @author hanbing
 * @version 12.2.0
 * @date 2024-04-18
 */
#include "HYYRobotInterface.h"
using namespace HYYRobotBase;//仅c++需要
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <thread>
#include <iostream>
//
#ifdef __cplusplus
extern "C" {
#endif
/**
 * @brief 插件入库函数,用于实现插件初始化(被控制系初始函数调用),该函数要求非阻塞，如阻塞需要开线程运行
 */
extern void PluginMain();
#ifdef __cplusplus
}
#endif

void PluginMain()
{
    ROBOT_INFO("PluginMain:rokae init\n");
    uint32_t tmp=0x808082A2;//0x808080A2;
    set_custom_device_data(get_deviceName(0,NULL),"OPERATION_WORD", &tmp, sizeof(uint32_t));
    unsigned short control[10]={128,128,128,128,128,128,128,128,128,128};
    usleep(100000);
    set_group_control(get_name_robot_device(get_deviceName(0,NULL),0), control);
}




